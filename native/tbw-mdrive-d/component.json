{
  "id": "tbw-mdrive-d",
  "kind": "tool",
  "version": "0.1.0",
  "title": "M Setup service",
  "description": "The service behind the M Setup app (TBW Performance): reads the M setup the car reports and asks the car for M1 / M2 / off with the command in this car's profile. Uses hmictl from IterioDev's Overlays tool (installed first).",
  "optional": true,
  "uninstallable": true,
  "mguHmi": ["ID8"],
  "requires": { "iteriodev-overlays": "0.4.0", "mgu-deploy": "0.7.11" },
  "files": [
    { "path": "mdrived.js", "from": "mdrived.js", "mode": "0644" },
    { "path": "profile.example.json", "from": "profile.example.json", "mode": "0644" }
  ],
  "units": [ { "name": "tbw-mdrive-d.service", "from": "tbw-mdrive-d.service" } ],
  "enable": [ { "unit": "tbw-mdrive-d.service", "target": "multi-user.target" } ],
  "recmgr": ["tbw-mdrive-d"],
  "crashNames": ["hmictl"],
  "restart": ["tbw-mdrive-d.service"]
}
